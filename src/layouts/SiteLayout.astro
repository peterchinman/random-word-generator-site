---
import ThemeInit from '../components/ThemeInit.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ThemeControls from '../components/ThemeControls.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/reset.css';
import '../styles/setup.css';
import '../styles/style.css';
interface Props { page: 'words' | 'phrases'; description: string }
const { page, description } = Astro.props;
const title = `Random ${page === 'phrases' ? 'Phrase' : 'Word'} Generator`;
const canonical = new URL(page === 'phrases' ? '/phrases/' : '/', Astro.site);
---
<!doctype html>
<html lang="en" class="pink light">
   <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <ThemeInit />
      <title>{title}</title>
      <meta name="description" content={description} />
      <meta property="og:image" content="https://randomwordgenerator.info/assets/images/sharecard.png" />
      <link rel="canonical" href={canonical} />
      <slot name="head" />
      <link rel="preload" href="/assets/fonts/roboto-mono-v31-latin.woff2" as="font" type="font/woff2" crossorigin />
   </head>
   <body class:list={{ 'phrase-page': page === 'phrases' }}>
      <SiteHeader page={page} />
      <slot />
      <ThemeControls />
      <SiteFooter />
      <script>
         import '../scripts/theme.js';
         import '../scripts/title-animation.js';
      </script>
   </body>
</html>
