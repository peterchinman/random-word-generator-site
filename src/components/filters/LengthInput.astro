---
interface Props { bound: 'min' | 'max' }
const { bound } = Astro.props;
const label = bound;
const description = bound === 'min' ? 'minimum' : 'maximum';
const name = `${bound}-word-length`;
---
<div class="number-input">
   <button type="button" class="decrement crement" aria-label={`Decrease ${description} word length`}>
      <svg class="decrement-svg" width="18" height="15" viewBox="0 0 18 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
         <path d="M17 1L9 13L1 0.999999" stroke="black" stroke-width="2" stroke-linecap="round"/>
      </svg>
   </button>
   <label><span>{label}</span>
      <input type="number" min="1" max="45" name={name}>
   </label>
   <button type="button" class="increment crement" aria-label={`Increase ${description} word length`}>
      <svg class="increment-svg" width="18" height="15" viewBox="0 0 18 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
         <path d="M1 14L9 2L17 14" stroke="black" stroke-width="2" stroke-linecap="round"/>
      </svg>
   </button>
</div>
